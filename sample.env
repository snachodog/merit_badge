# Copy to .env and edit. NEVER commit .env. No value below is a real secret.

# --- Django ---------------------------------------------------------------
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# Comma-separated hostnames you will browse to (and your proxy's public name).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated full origins incl. scheme, required behind HTTPS proxy, e.g.
# https://merit.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set true when users reach the site over HTTPS (direct or via proxy).
DJANGO_SECURE_COOKIES=false
# Set true ONLY behind a proxy that always sets X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=false
# HSTS seconds (0 = off). Prefer configuring HSTS at the proxy.
DJANGO_HSTS_SECONDS=0

# --- Image (used by sample.docker-compose.yaml) -----------------------------
# Pin an exact release such as 0.4.0 for repeatable installs. "latest" follows
# the newest release tag. Until the first image release, use "main".
MERIT_BADGE_IMAGE=dogiakos/merit_badge
MERIT_BADGE_VERSION=latest

# --- Web port --------------------------------------------------------------
# Host interface/port the web container is published on. Default is loopback
# only; set WEB_BIND=0.0.0.0 to expose on the LAN (or leave loopback and use a
# reverse proxy on the same host).
WEB_BIND=127.0.0.1
WEB_PORT=8000

# --- PostgreSQL (internal to the compose network; never published) -----------
POSTGRES_DB=meritbadge
POSTGRES_USER=meritbadge
# Choose a strong password before the FIRST start (it is baked into pgdata).
POSTGRES_PASSWORD=

# --- Optional first-user bootstrap -----------------------------------------
# If both username and password are set, the web container creates this superuser
# at start (no-op if it exists; it never changes an existing password).
# To set a new password, run: python manage.py bootstrap_admin --reset-password
# Remove the password from this file afterwards.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

# --- Evidence uploads ---------------------------------------------------------
# Largest evidence file in megabytes (default 25). Allowed file types are listed in
# app/evidence/validation.py. Files are stored under DJANGO_MEDIA_ROOT/evidence.
EVIDENCE_MAX_UPLOAD_MB=25
